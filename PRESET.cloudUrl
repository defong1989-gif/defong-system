<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>紡織廠生產管理系統</title>
<style>
:root{--pri:#0f766e;--pri2:#115e59;--bg:#f3f4f6;--card:#fff;--bd:#e5e7eb;--tx:#1f2937;--mu:#6b7280;--red:#dc2626;--amb:#d97706;--grn:#16a34a;--blu:#2563eb}
*{box-sizing:border-box}
body{margin:0;font-family:"Noto Sans TC","Microsoft JhengHei","PingFang TC",system-ui,sans-serif;background:var(--bg);color:var(--tx);font-size:14px}
#app{display:flex;min-height:100vh}
#side{width:200px;background:#0b3b38;color:#d1fae5;flex-shrink:0;padding:12px 0;position:sticky;top:0;height:100vh;overflow:auto}
.brand{font-weight:700;font-size:16px;padding:8px 16px 14px;color:#fff}
.nsec{font-size:11px;color:#6ee7b7;padding:10px 16px 4px;letter-spacing:1px}
#nav a{display:block;padding:8px 16px;color:#d1fae5;text-decoration:none;border-left:3px solid transparent}
#nav a:hover{background:#115e59}
#nav a.on{background:#115e59;border-left-color:#5eead4;color:#fff;font-weight:600}
#content{flex:1;min-width:0}
.top{display:flex;align-items:center;gap:10px;background:#fff;border-bottom:1px solid var(--bd);padding:8px 16px;position:sticky;top:0;z-index:20}
.grow{flex:1}.menu{display:none}
.sync{font-size:12px;padding:3px 8px;border-radius:99px;background:#e5e7eb;color:#374151}
.sync.ok{background:#dcfce7;color:#166534}.sync.err{background:#fee2e2;color:#991b1b}
main{padding:16px;max-width:1400px}
.head{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px}
.head h2{margin:0;font-size:20px;flex:1}.head h3{margin:0;flex:1}.head.sub{margin-top:18px}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.btn{border:1px solid var(--bd);background:#fff;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:13px;color:var(--tx)}
.btn:hover{background:#f9fafb}.btn.pri{background:var(--pri);border-color:var(--pri);color:#fff}.btn.pri:hover{background:var(--pri2)}
.btn.danger{color:var(--red)}.btn.sm{padding:3px 8px;font-size:12px}
.search,input,select,textarea{border:1px solid #d1d5db;border-radius:6px;padding:6px 8px;font:inherit;background:#fff;width:100%}
.search{width:220px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:14px;margin-bottom:14px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px}
.kpi{background:#fff;border:1px solid var(--bd);border-radius:10px;padding:12px 14px}
.kpi b{display:block;font-size:24px;margin-top:4px}.kpi span{color:var(--mu);font-size:12px}
.tbl-wrap{overflow-x:auto;background:#fff;border:1px solid var(--bd);border-radius:10px}
table{border-collapse:collapse;width:100%}
th,td{padding:8px 10px;border-bottom:1px solid var(--bd);text-align:left;white-space:nowrap}
th{background:#f9fafb;font-weight:600;font-size:12px;color:var(--mu);position:sticky;top:0}
td.num,th.num{text-align:right}
tr:hover td{background:#f9fafb}
td.act{text-align:right}
.empty{padding:28px;text-align:center;color:var(--mu)}
.badge{display:inline-block;padding:1px 8px;border-radius:99px;font-size:12px;background:#e5e7eb;color:#374151}
.badge.green{background:#dcfce7;color:#166534}.badge.blue{background:#dbeafe;color:#1e40af}.badge.amber{background:#fef3c7;color:#92400e}.badge.red{background:#fee2e2;color:#991b1b}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:50;overflow:auto;padding:30px 12px}
.modal.open{display:block}
.box{background:#fff;border-radius:12px;max-width:720px;margin:0 auto}.box.wide{max-width:900px}
.mh{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--bd);font-size:16px}
.mbody{padding:16px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fld.full{grid-column:1/-1}
.fld label{display:block;font-size:12px;color:var(--mu);margin-bottom:3px}
.fld label i{color:var(--red);font-style:normal}
.hint{display:block;color:var(--blu);font-size:12px;margin-top:3px;min-height:14px}
.mfoot{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;grid-column:1/-1}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#111827;color:#fff;padding:9px 16px;border-radius:8px;display:none;z-index:99;max-width:90%}
#toast.err{background:#b91c1c}
.gantt-sc{overflow-x:auto}
.g-row{display:grid;grid-template-columns:130px 1fr;border-bottom:1px solid var(--bd)}
.g-label{padding:6px 8px;font-size:12px;border-right:1px solid var(--bd);background:#f9fafb}
.g-label small{display:block;color:var(--mu)}
.g-head{display:grid;font-size:11px;text-align:center;color:var(--mu)}
.g-head div{padding:4px 0;border-right:1px solid var(--bd)}.g-head .we{background:#fef2f2}.g-head .td{background:#ccfbf1;color:#115e59;font-weight:700}
.g-grid{display:grid;row-gap:2px;padding:4px 0;position:relative}
.g-today{background:rgba(20,184,166,.12);z-index:0}
.bar{z-index:1;border-radius:4px;color:#fff;font-size:11px;padding:3px 5px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:pointer;background:#6b7280}
.bar.s1{background:#2563eb}.bar.s2{background:#16a34a}.bar.s3{background:#dc2626}.bar.s0{background:#6b7280}
.prog{height:8px;background:#e5e7eb;border-radius:99px;overflow:hidden}.prog i{display:block;height:100%;background:var(--pri)}
.legend span{margin-right:12px;font-size:12px}
.legend b{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:4px}
#printArea{display:none}
@media print{body>*:not(#printArea){display:none!important}#printArea{display:block;padding:10mm}}
@media(max-width:800px){#side{position:fixed;left:-220px;z-index:40;transition:left .2s}#side.open{left:0}.menu{display:inline-block}.grid,.two{grid-template-columns:1fr}.search{width:140px}main{padding:10px}}
</style>
</head>
<body>
<div id="app">
 <aside id="side"><div class="brand">🧵 <span id="brandName"></span></div><nav id="nav"></nav></aside>
 <div id="content">
  <header class="top"><button class="btn menu" data-act="menu">☰</button><div class="grow"></div><span id="sync" class="sync">本機模式</span><button class="btn" data-act="rename">👤 <span id="uname"></span></button></header>
  <main id="main"></main>
 </div>
</div>
<div id="modal" class="modal"><div class="box" id="box"><div class="mh"><b id="mt"></b><button class="btn sm" data-act="close">✕</button></div><div class="mbody" id="mb"></div></div></div>
<div id="toast"></div>
<div id="printArea"></div>

<script>
/* ================= 部署設定 =================
   填入 Firebase Realtime Database 網址後,所有使用者打開網頁就會自動連到同一個資料庫。
   例: 'https://xxxx-default-rtdb.asia-southeast1.firebasedatabase.app'
   留空 = 單機模式(資料只存在各自瀏覽器)。也可在「系統設定」頁面由介面輸入。 */
const PRESET={cloudUrl:'',auth:'',company:'○○紡織股份有限公司'};

/* ================= 工具 ================= */
const $=(s,e=document)=>e.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=v=>{const n=parseFloat(v);return isNaN(n)?0:n};
const fmt=(n,d=2)=>Number(n||0).toLocaleString('zh-TW',{maximumFractionDigits:d});
const pad=(n,l=2)=>String(n).padStart(l,'0');
const ymd=d=>new Date(d.getTime()-d.getTimezoneOffset()*6e4).toISOString().slice(0,10);
const today=()=>ymd(new Date());
const addDays=(d,n)=>{const x=new Date(d+'T00:00:00');x.setDate(x.getDate()+n);return ymd(x)};
const diffDays=(a,b)=>Math.round((new Date(b+'T00:00:00')-new Date(a+'T00:00:00'))/864e5);
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const sum=(a,k)=>a.reduce((s,r)=>s+num(r[k]),0);
const all=c=>Object.values(DB[c]||{});

/* ================= 資料與儲存 ================= */
const COLS=['customers','suppliers','yarns','fabrics','machines','orders','schedules','yarnIn','yarnOut','fabricIn','shipments','logs'];
const emptyDB=()=>{const d={};COLS.forEach(c=>d[c]={});return d};
let DB=emptyDB();
const saved=JSON.parse(localStorage.getItem('tex_cfg')||'{}');
const CFG={url:saved.url??PRESET.cloudUrl,auth:saved.auth??PRESET.auth,company:saved.company??PRESET.company};
let USER=localStorage.getItem('tex_user')||'';
const cloudOn=()=>!!CFG.url;
let writes=0,pend=false;
function norm(d){const n=emptyDB();COLS.forEach(c=>{const v=d&&d[c];if(v&&typeof v==='object'){Object.keys(v).forEach(id=>{const r=v[id];if(r&&typeof r==='object'){if(r.lines&&!Array.isArray(r.lines))r.lines=Object.values(r.lines);n[c][id]=r}})}});return n}
const sig=d=>COLS.map(c=>{const v=Object.values(d[c]||{});return v.length+':'+v.reduce((m,r)=>Math.max(m,r.updatedAt||0),0)}).join('|');
function cache(){try{localStorage.setItem('tex_db',JSON.stringify(DB))}catch(e){}}
function setSync(s,msg){const e=$('#sync');if(!cloudOn()){e.className='sync';e.textContent='本機模式';return}
 e.className='sync '+s;e.textContent=s==='ok'?'☁ 雲端同步中':'☁ 連線異常'+(msg?'('+msg+')':'')}
const cBase=()=>CFG.url.replace(/\/+$/,'')+'/tex_erp';
async function cReq(path,method,body){
 try{const u=cBase()+path+'.json'+(CFG.auth?'?auth='+encodeURIComponent(CFG.auth):'');
  const r=await fetch(u,{method,headers:body!==undefined?{'Content-Type':'application/json'}:undefined,body:body!==undefined?JSON.stringify(body):undefined});
  if(!r.ok)throw new Error('HTTP '+r.status);setSync('ok');return await r.json()}
 catch(e){setSync('err',e.message);throw e}}
function put(col,rec){if(!rec.id)rec.id=uid();rec.updatedAt=Date.now();rec.updatedBy=USER;DB[col][rec.id]=rec;writes++;cache();
 if(cloudOn())cReq(`/${col}/${rec.id}`,'PUT',rec).catch(()=>{});return rec}
function del(col,id){delete DB[col][id];writes++;cache();if(cloudOn())cReq(`/${col}/${id}`,'DELETE').catch(()=>{})}
function log(act,desc){put('logs',{ts:Date.now(),user:USER,act,desc})}
async function pushAll(){const o={};COLS.forEach(c=>{if(Object.keys(DB[c]).length)o[c]=DB[c]});await cReq('','PUT',o)}
const canRender=()=>!$('#modal').classList.contains('open')&&!/INPUT|SELECT|TEXTAREA/.test((document.activeElement||{}).tagName||'');
async function pull(force){
 if(!cloudOn())return;const w=writes;
 try{const d=await cReq('','GET');if(w!==writes)return;const nd=norm(d||{});
  if(force||sig(nd)!==sig(DB)){DB=nd;cache();if(canRender())route();else pend=true}
  else if(pend&&canRender()){pend=false;route()}}catch(e){}}

/* ================= 標籤與計算 ================= */
const byCode=(a,b)=>String(a.code||'').localeCompare(String(b.code||''),'zh-Hant');
const LBL={customers:r=>`${r.code} ${r.name}`,suppliers:r=>r.name,yarns:r=>`${r.code} ${r.name}`,fabrics:r=>`${r.code} ${r.name}`,
 machines:r=>`${r.code} ${r.name||''}`.trim(),
 orders:r=>`${r.orderNo}｜${DB.customers[r.customer]?.name||''}｜${DB.fabrics[r.fabric]?.code||''}${r.color?'/'+r.color:''}`};
const label=(c,r)=>LBL[c]?LBL[c](r):(r.name||r.code||r.id);
const nm=(c,id)=>{const r=DB[c]?.[id];return r?label(c,r):(id?'(已刪除)':'')};
function nextNo(prefix,col,key){const p=prefix+today().replace(/-/g,'').slice(2)+'-';const n=all(col).filter(r=>String(r[key]||'').startsWith(p)).length+1;return p+pad(n)}

function yarnBal(y,l,ex){let b=0;
 all('yarnIn').forEach(r=>{if(r.id!==ex&&r.yarn===y&&r.lot===l&&r.qc!=='退貨')b+=num(r.qty)});
 all('yarnOut').forEach(r=>{if(r.id!==ex&&r.yarn===y&&r.lot===l)b-=(r.type==='退回'?-1:1)*num(r.qty)});return b}
function yarnRows(){const m={};const g=(y,l)=>m[y+'§'+l]||(m[y+'§'+l]={yarn:y,lot:l,loc:'',inQ:0,outQ:0});
 all('yarnIn').filter(r=>r.qc!=='退貨').forEach(r=>{const o=g(r.yarn,r.lot);o.inQ+=num(r.qty);if(r.loc)o.loc=r.loc;o.last=r.date});
 all('yarnOut').forEach(r=>{const o=g(r.yarn,r.lot);o.outQ+=(r.type==='退回'?-1:1)*num(r.qty)});
 return Object.values(m).map(o=>({...o,bal:o.inQ-o.outQ}))}
const yarnTotal=y=>yarnRows().filter(r=>r.yarn===y).reduce((s,r)=>s+r.bal,0);
const fsign=r=>r.type==='盤點減少'?-1:1;
function fabricRows(exShip,exIn){const m={};const g=(f,c,l)=>m[f+'§'+c+'§'+l]||(m[f+'§'+c+'§'+l]={fabric:f,color:c,lot:l,loc:'',inQ:0,outQ:0,inR:0,outR:0});
 all('fabricIn').forEach(r=>{if(r.id===exIn)return;const o=g(r.fabric,r.color||'',r.lot||'');o.inQ+=fsign(r)*num(r.qty);o.inR+=fsign(r)*num(r.rolls);if(r.loc)o.loc=r.loc});
 all('shipments').forEach(s=>{if(s.id===exShip)return;(s.lines||[]).forEach(l=>{const o=g(l.fabric,l.color||'',l.lot||'');o.outQ+=num(l.qty);o.outR+=num(l.rolls)})});
 return Object.values(m).map(o=>({...o,bal:o.inQ-o.outQ,balR:o.inR-o.outR}))}
function ordStat(o){
 const sch=all('schedules').filter(s=>s.order===o.id),ships=all('shipments').filter(s=>s.order===o.id),outs=all('yarnOut').filter(y=>y.order===o.id);
 const shipped=ships.reduce((a,s)=>a+(s.lines||[]).reduce((b,l)=>b+num(l.qty),0),0);
 const issued=outs.reduce((a,y)=>a+(y.type==='退回'?-1:1)*num(y.qty),0);
 const f=DB.fabrics[o.fabric];
 return{sch,ships,outs,planned:sum(sch,'planQty'),done:sum(sch,'doneQty'),shipped,issued,need:num(o.qty)*(num(f?.ratio)||1)}}
function syncOrder(id){const o=DB.orders[id];if(!o||o.status==='已取消')return;const s=ordStat(o);let st='待排工';
 if(s.planned>0||s.done>0)st='生產中';if(s.done>=num(o.qty)&&s.done>0)st='待出貨';
 if(s.shipped>0)st='部分出貨';if(s.shipped>=num(o.qty)&&num(o.qty)>0)st='已出貨';
 if(st!==o.status){o.status=st;put('orders',o)}}

/* ================= 欄位結構 ================= */
const ORD_ST=['待排工','生產中','待出貨','部分出貨','已出貨','已取消'];
const BADGE={'待排工':'','生產中':'blue','待出貨':'amber','部分出貨':'amber','已出貨':'green','已取消':'red','待生產':'','已完成':'green','暫停':'red','合格':'green','待驗':'amber','退貨':'red','可用':'green','維修中':'amber','停用':'red','領用':'blue','退回':'amber'};
let EDIT_ID=null;
const S={
customers:{title:'客戶資料',fields:[
 {k:'code',l:'客戶代號',req:1,unique:1},{k:'name',l:'客戶名稱',req:1},{k:'contact',l:'聯絡人'},{k:'phone',l:'電話'},{k:'email',l:'Email'},{k:'taxId',l:'統一編號'},
 {k:'addr',l:'送貨地址',full:1},{k:'terms',l:'付款條件',t:'select',opts:['現金','月結30天','月結60天','月結90天','票期30天','票期60天']},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['code','name','contact','phone','terms'],sort:['code',1]},
suppliers:{title:'供應商資料',fields:[
 {k:'code',l:'供應商代號',req:1,unique:1},{k:'name',l:'供應商名稱',req:1},{k:'contact',l:'聯絡人'},{k:'phone',l:'電話'},{k:'addr',l:'地址',full:1},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['code','name','contact','phone'],sort:['code',1]},
yarns:{title:'紗線資料',fields:[
 {k:'code',l:'紗線代號',req:1,unique:1},{k:'name',l:'品名/規格(如 40/1 精梳棉)',req:1},{k:'material',l:'材質'},{k:'color',l:'顏色'},
 {k:'safety',l:'安全庫存(kg)',t:'number'},{k:'price',l:'參考單價(元/kg)',t:'number'},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['code','name','material','color','safety','price'],sort:['code',1],
 extra:[{l:'目前庫存(kg)',num:1,f:r=>fmt(yarnTotal(r.id))}]},
fabrics:{title:'布種資料',fields:[
 {k:'code',l:'布種代號',req:1,unique:1},{k:'name',l:'布種名稱',req:1},{k:'composition',l:'成分'},{k:'width',l:'幅寬(cm)',t:'number'},{k:'gsm',l:'克重(g/m²)',t:'number'},
 {k:'yarn',l:'主要用紗',t:'ref',ref:'yarns'},{k:'ratio',l:'用紗比(kg紗/kg布)',t:'number',def:1.05},{k:'price',l:'參考單價(元/kg)',t:'number'},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['code','name','composition','width','gsm','yarn','ratio'],sort:['code',1]},
machines:{title:'機台資料',fields:[
 {k:'code',l:'機台編號',req:1,unique:1},{k:'name',l:'機台名稱/規格'},{k:'type',l:'類型',t:'select',opts:['圓編機','經編機','梭織機','染色機','定型機','其他'],req:1},
 {k:'cap',l:'日產能(kg/日)',t:'number'},{k:'status',l:'狀態',t:'select',opts:['可用','維修中','停用'],def:'可用',badge:1,req:1},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['code','name','type','cap','status'],sort:['code',1]},
orders:{title:'訂單管理',fields:[
 {k:'orderNo',l:'訂單編號',req:1,unique:1,auto:()=>nextNo('SO','orders','orderNo')},{k:'date',l:'接單日期',t:'date',req:1,def:today},
 {k:'customer',l:'客戶',t:'ref',ref:'customers',req:1},{k:'po',l:'客戶單號'},
 {k:'fabric',l:'布種',t:'ref',ref:'fabrics',req:1},{k:'color',l:'顏色/色號'},
 {k:'qty',l:'訂購量(kg)',t:'number',req:1,pos:1,hint:v=>{const f=DB.fabrics[v.fabric];if(!f||!num(v.qty))return'';const y=DB.yarns[f.yarn];
   return `預估用紗 ${fmt(num(v.qty)*(num(f.ratio)||1))} kg(${y?y.name:'未設定用紗'})｜目前該紗庫存 ${fmt(y?yarnTotal(y.id):0)} kg`}},
 {k:'price',l:'單價(元/kg)',t:'number'},{k:'dueDate',l:'交貨日期',t:'date',req:1},{k:'status',l:'狀態',t:'select',opts:ORD_ST,req:1,def:'待排工',badge:1},
 {k:'note',l:'備註',t:'textarea',full:1}],
 cols:['orderNo','date','customer','fabric','color','qty','dueDate','status'],sort:['date',-1],actions:[['detail','詳情']],
 extra:[{l:'已排工',num:1,f:r=>fmt(ordStat(r).planned,1)},{l:'完成量',num:1,f:r=>fmt(ordStat(r).done,1)},{l:'已出貨',num:1,f:r=>fmt(ordStat(r).shipped,1)},{l:'未交(kg)',num:1,f:r=>fmt(Math.max(0,num(r.qty)-ordStat(r).shipped),1)}],
 afterSave:r=>syncOrder(r.id)},
schedules:{title:'排工明細',fields:[
 {k:'order',l:'訂單',t:'ref',ref:'orders',req:1,filter:o=>!['已出貨','已取消'].includes(o.status),full:1},
 {k:'machine',l:'機台',t:'ref',ref:'machines',req:1,filter:m=>m.status!=='停用'},
 {k:'status',l:'狀態',t:'select',opts:['待生產','生產中','已完成','暫停'],def:'待生產',badge:1,req:1},
 {k:'start',l:'開始日期',t:'date',req:1,def:today},{k:'end',l:'結束日期',t:'date',req:1,def:()=>addDays(today(),2)},
 {k:'planQty',l:'計畫產量(kg)',t:'number',req:1,pos:1,hint:v=>{const m=DB.machines[v.machine];if(!m||!v.start||!v.end||!num(m.cap))return'';const d=diffDays(v.start,v.end)+1;return `機台日產能 ${fmt(m.cap)}kg × ${d}天 = ${fmt(m.cap*d)}kg`}},
 {k:'doneQty',l:'已完成產量(kg)',t:'number',def:0},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['order','machine','start','end','planQty','doneQty','status'],sort:['start',-1],
 validate:(v,old)=>{if(v.end<v.start)return{error:'結束日期不可早於開始日期'};const w=[];const m=DB.machines[v.machine];
  if(m&&m.status!=='可用')w.push(`機台「${m.code}」目前為${m.status}`);
  const d=diffDays(v.start,v.end)+1;if(m&&num(m.cap)&&num(v.planQty)>num(m.cap)*d)w.push(`計畫量 ${fmt(v.planQty)}kg 超過機台產能 ${fmt(m.cap*d)}kg(${d}天)`);
  const ov=all('schedules').filter(s=>s.id!==old?.id&&s.machine===v.machine&&!['已完成','暫停'].includes(s.status)&&!(s.end<v.start||s.start>v.end));
  if(v.status!=='暫停'&&ov.length)w.push('與既有排工時間重疊:'+ov.map(s=>DB.orders[s.order]?.orderNo||'').join('、'));
  return w.length?{warn:w.join('\n')+'\n\n仍要儲存嗎?'}:null},
 afterSave:r=>syncOrder(r.order),afterDel:r=>syncOrder(r.order)},
yarnIn:{title:'入紗作業',fields:[
 {k:'date',l:'入庫日期',t:'date',req:1,def:today},{k:'poNo',l:'進貨單/採購單號'},
 {k:'supplier',l:'供應商',t:'ref',ref:'suppliers',req:1},{k:'yarn',l:'紗線',t:'ref',ref:'yarns',req:1},
 {k:'lot',l:'批號(Lot)',req:1},{k:'qty',l:'數量(kg)',t:'number',req:1,pos:1},{k:'bags',l:'件數(包/箱)',t:'number'},{k:'price',l:'單價(元/kg)',t:'number'},
 {k:'loc',l:'倉位'},{k:'qc',l:'驗收結果',t:'select',opts:['合格','待驗','退貨'],def:'合格',badge:1,req:1},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['date','poNo','supplier','yarn','lot','qty','bags','loc','qc'],sort:['date',-1],
 validate:(v,old)=>{if(old&&old.qc!=='退貨'){const b=yarnBal(old.yarn,old.lot,old.id);if(b<0&&(v.yarn!==old.yarn||v.lot!==old.lot||v.qc==='退貨'||num(v.qty)<num(old.qty)))return{warn:'此批紗已有領用紀錄,修改可能造成庫存為負。仍要儲存嗎?'}}return null}},
yarnOut:{title:'領紗/退紗',fields:[
 {k:'date',l:'日期',t:'date',req:1,def:today},{k:'type',l:'類別',t:'select',opts:['領用','退回'],def:'領用',badge:1,req:1},
 {k:'order',l:'對應訂單',t:'ref',ref:'orders',filter:o=>!['已出貨','已取消'].includes(o.status),full:1},
 {k:'yarn',l:'紗線',t:'ref',ref:'yarns',req:1},
 {k:'lot',l:'批號(Lot)',req:1,dl:v=>yarnRows().filter(r=>r.yarn===v.yarn&&(r.bal>0.0001||r.lot===v.lot)).map(r=>r.lot)},
 {k:'qty',l:'數量(kg)',t:'number',req:1,pos:1,hint:v=>v.yarn&&v.lot!==undefined&&v.lot!==''?`該批目前庫存 ${fmt(yarnBal(v.yarn,v.lot,EDIT_ID))} kg`:''},
 {k:'machine',l:'機台',t:'ref',ref:'machines'},{k:'by',l:'領料人',def:()=>USER},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['date','type','order','yarn','lot','qty','machine','by'],sort:['date',-1],
 validate:(v,old)=>{if(v.type==='領用'&&num(v.qty)>yarnBal(v.yarn,v.lot,old?.id)+1e-6)return{error:`庫存不足:該批目前僅 ${fmt(yarnBal(v.yarn,v.lot,old?.id))} kg`};return null}},
fabricIn:{title:'布入庫/調整',fields:[
 {k:'date',l:'日期',t:'date',req:1,def:today},{k:'type',l:'類別',t:'select',opts:['下機入庫','染整入庫','退貨入庫','盤點增加','盤點減少'],def:'下機入庫',req:1},
 {k:'order',l:'對應訂單',t:'ref',ref:'orders',full:1},{k:'fabric',l:'布種',t:'ref',ref:'fabrics',req:1},{k:'color',l:'顏色/色號'},
 {k:'lot',l:'缸號/批號',req:1},
 {k:'qty',l:'數量(kg)',t:'number',req:1,pos:1,hint:v=>v.fabric&&v.lot!==undefined&&v.lot!==''?`該缸目前庫存 ${fmt((fabricRows(null,EDIT_ID).find(r=>r.fabric===v.fabric&&r.color===(v.color||'')&&r.lot===v.lot)||{bal:0}).bal)} kg`:''},
 {k:'rolls',l:'捲數',t:'number'},{k:'loc',l:'倉位'},{k:'note',l:'備註',t:'textarea',full:1}],
 cols:['date','type','order','fabric','color','lot','qty','rolls','loc'],sort:['date',-1],
 validate:(v,old)=>{if(v.type==='盤點減少'){const r=fabricRows(null,old?.id).find(r=>r.fabric===v.fabric&&r.color===(v.color||'')&&r.lot===v.lot);if(num(v.qty)>(r?r.bal:0)+1e-6)return{error:`庫存不足:該缸目前僅 ${fmt(r?r.bal:0)} kg`}}return null}},
shipments:{title:'出貨作業',custom:1,fields:[
 {k:'shipNo',l:'出貨單號'},{k:'date',l:'出貨日期',t:'date'},{k:'customer',l:'客戶',t:'ref',ref:'customers'},{k:'order',l:'訂單',t:'ref',ref:'orders'},
 {k:'carrier',l:'車號/物流'},{k:'addr',l:'送貨地址'},{k:'total',l:'出貨量(kg)',t:'number'},{k:'note',l:'備註'}],
 cols:['shipNo','date','customer','order','total','carrier'],sort:['date',-1],actions:[['print','列印']],
 extra:[{l:'捲數',num:1,f:r=>fmt(sum(r.lines||[],'rolls'),0)}],afterDel:r=>syncOrder(r.order)},
};

/* ================= 通用列表/表單 ================= */
function cellHTML(f,r){const v=r[f.k];
 if(f.t==='ref')return esc(nm(f.ref,v));
 if(f.badge&&v)return `<span class="badge ${BADGE[v]||''}">${esc(v)}</span>`;
 if(f.t==='number')return v===''||v==null?'':fmt(v);
 return esc(v??'')}
function cellText(f,r){const v=r[f.k];if(f.t==='ref')return nm(f.ref,v);if(f.t==='number'&&v!==''&&v!=null)return fmt(v);return v??''}
function sorted(col,rows){const [k,d]=S[col].sort||['updatedAt',-1];return rows.sort((a,b)=>{const x=a[k]??'',y=b[k]??'';return (x>y?1:x<y?-1:0)*d||(b.updatedAt||0)-(a.updatedAt||0)})}
function tableHTML(col){
 const s=S[col],q=(state.q[col]||'').toLowerCase();
 const cols=s.cols.map(k=>s.fields.find(f=>f.k===k));
 let rows=sorted(col,all(col)).map(r=>({r,txt:cols.map(f=>cellText(f,r)).concat((s.extra||[]).map(e=>e.f(r))).join(' ').toLowerCase()}));
 if(q)rows=rows.filter(x=>x.txt.includes(q));
 if(!rows.length)return `<div class="tbl-wrap"><div class="empty">${q?'找不到符合的資料':'尚無資料,請點「＋ 新增」'}</div></div>`;
 const acts=(s.actions||[]).map(a=>a);
 return `<div class="tbl-wrap"><table><thead><tr>${cols.map(f=>`<th class="${f.t==='number'?'num':''}">${esc(f.l)}</th>`).join('')}${(s.extra||[]).map(e=>`<th class="num">${esc(e.l)}</th>`).join('')}<th></th></tr></thead><tbody>`+
 rows.map(({r})=>`<tr>${cols.map(f=>`<td class="${f.t==='number'?'num':''}">${cellHTML(f,r)}</td>`).join('')}${(s.extra||[]).map(e=>`<td class="num">${esc(e.f(r))}</td>`).join('')}<td class="act">${acts.map(a=>`<button class="btn sm" data-act="${a[0]}" data-col="${col}" data-id="${r.id}">${a[1]}</button>`).join(' ')} <button class="btn sm" data-act="edit" data-col="${col}" data-id="${r.id}">編輯</button> <button class="btn sm danger" data-act="del" data-col="${col}" data-id="${r.id}">刪除</button></td></tr>`).join('')+`</tbody></table></div>`}
const listWrap=c=>`<div id="list_${c}">${tableHTML(c)}</div>`;
const searchBox=c=>`<input class="search" data-act="q" data-col="${c}" placeholder="搜尋…" value="${esc(state.q[c]||'')}">`;
function crudPage(col){return `<div class="head"><h2>${S[col].title}</h2><div class="tools">${searchBox(col)}<button class="btn" data-act="csv" data-col="${col}">匯出 CSV</button><button class="btn pri" data-act="add" data-col="${col}">＋ 新增</button></div></div>`+listWrap(col)}

function refOpts(f,cur){let rs=all(f.ref);if(f.filter)rs=rs.filter(r=>f.filter(r)||r.id===cur);
 return rs.map(r=>[r.id,label(f.ref,r)]).sort((a,b)=>String(a[1]).localeCompare(String(b[1]),'zh-Hant'))}
function fieldHTML(f,v){
 const nmA=`name="${f.k}" id="f_${f.k}"`,rq=f.req?' required':'';let inp;
 if(f.t==='ref'||f.t==='select'){const o=f.t==='ref'?refOpts(f,v):f.opts.map(x=>[x,x]);
  inp=`<select ${nmA}${rq}><option value="">${f.req?'請選擇':'—'}</option>${o.map(([a,b])=>`<option value="${esc(a)}"${a===v?' selected':''}>${esc(b)}</option>`).join('')}</select>`}
 else if(f.t==='textarea')inp=`<textarea ${nmA} rows="2">${esc(v)}</textarea>`;
 else if(f.t==='number')inp=`<input ${nmA} type="number" step="any" inputmode="decimal" value="${esc(v)}"${rq}>`;
 else if(f.t==='date')inp=`<input ${nmA} type="date" value="${esc(v)}"${rq}>`;
 else inp=`<input ${nmA} type="text" value="${esc(v)}"${rq}${f.dl?` list="dl_${f.k}"`:''}>${f.dl?`<datalist id="dl_${f.k}"></datalist>`:''}`;
 return `<div class="fld${f.full?' full':''}"><label>${esc(f.l)}${f.req?' <i>*</i>':''}</label>${inp}${f.hint?`<span class="hint" id="h_${f.k}"></span>`:''}</div>`}
function formVals(form,s){const v={};s.fields.forEach(f=>{const e=form.querySelector(`[name="${f.k}"]`);if(!e)return;v[f.k]=f.t==='number'?(e.value===''?'':num(e.value)):e.value.trim()});return v}
function refreshDyn(form,s){const v=formVals(form,s);s.fields.forEach(f=>{
 if(f.dl){const d=$(`#dl_${f.k}`,form);if(d)d.innerHTML=[...new Set(f.dl(v))].map(x=>`<option value="${esc(x)}">`).join('')}
 if(f.hint){const h=$(`#h_${f.k}`,form);if(h)h.textContent=f.hint(v)||''}})}

function openModal(title,html,wide){$('#mt').textContent=title;$('#mb').innerHTML=html;$('#box').className='box'+(wide?' wide':'');$('#modal').classList.add('open');$('#mb').oninput=$('#mb').onchange=null}
function closeModal(){$('#modal').classList.remove('open');SH=null;EDIT_ID=null}
function openForm(col,id){
 if(col==='shipments')return openShip(id);
 const s=S[col],old=id?DB[col][id]:null;EDIT_ID=id||null;
 const rec={};s.fields.forEach(f=>{rec[f.k]=old?old[f.k]:(f.auto?f.auto():(typeof f.def==='function'?f.def():f.def))??''});
 openModal((old?'編輯':'新增')+' — '+s.title,`<form id="frm" class="grid">${s.fields.map(f=>fieldHTML(f,rec[f.k])).join('')}<div class="mfoot"><button type="button" class="btn" data-act="close">取消</button><button class="btn pri">儲存</button></div></form>`);
 const form=$('#frm');refreshDyn(form,s);$('#mb').oninput=$('#mb').onchange=()=>refreshDyn(form,s);
 form.onsubmit=e=>{e.preventDefault();const v=formVals(form,s);
  for(const f of s.fields){if(f.pos&&!(num(v[f.k])>0))return toast(`「${f.l}」必須大於 0`,1);
   if(f.unique&&all(col).some(r=>r.id!==id&&String(r[f.k]).toLowerCase()===String(v[f.k]).toLowerCase()))return toast(`「${f.l}」已存在,不可重複`,1)}
  const r=s.validate?s.validate(v,old):null;if(r?.error)return toast(r.error,1);if(r?.warn&&!confirm(r.warn))return;
  const nrec=put(col,{...(old||{}),...v,...(old?{}:{createdAt:Date.now()})});
  s.afterSave?.(nrec,old);log(old?'修改':'新增',`${s.title}:${s.fields[0].k&&nrec[s.fields[0].k]!==undefined?cellText(s.fields[0],nrec):''}`);
  closeModal();route();toast('已儲存')}}
function usedBy(col,id){const out=[];Object.keys(S).forEach(c=>{S[c].fields.forEach(f=>{if(f.t==='ref'&&f.ref===col&&all(c).some(r=>r[f.k]===id))out.push(S[c].title)})});return[...new Set(out)]}
function delRec(col,id){const s=S[col],r=DB[col][id];if(!r)return;const u=usedBy(col,id);
 if(u.length)return toast(`無法刪除:已被「${u.join('、')}」使用`,1);
 if(!confirm('確定刪除這筆資料?此動作無法復原。'))return;
 del(col,id);s.afterDel?.(r);log('刪除',`${s.title}:${cellText(s.fields[0],r)}`);route();toast('已刪除')}
function csvOut(col){const s=S[col];const rows=[s.fields.map(f=>f.l)].concat(sorted(col,all(col)).map(r=>s.fields.map(f=>cellText(f,r))));dl(`${s.title}_${today()}.csv`,rows)}
function dl(name,rows){const csv='\ufeff'+rows.map(r=>r.map(c=>`"${String(c??'').replace(/"/g,'""')}"`).join(',')).join('\r\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download=name;a.click()}
let tt;function toast(m,err){const t=$('#toast');t.textContent=m;t.className=err?'err':'';t.style.display='block';clearTimeout(tt);tt=setTimeout(()=>t.style.display='none',err?4000:1800)}

/* ================= 出貨單 ================= */
let SH=null;
function openShip(id){const old=id?DB.shipments[id]:null;
 SH={id:id||null,rec:old?JSON.parse(JSON.stringify(old)):{shipNo:nextNo('SH','shipments','shipNo'),date:today(),customer:'',order:'',carrier:'',addr:'',note:'',lines:[{color:'',lot:'',rolls:'',qty:''}]}};
 if(!SH.rec.lines.length)SH.rec.lines=[{color:'',lot:'',rolls:'',qty:''}];
 const r=SH.rec;
 openModal(old?'編輯出貨單':'新增出貨單',`<form id="shf" class="grid">
 <div class="fld"><label>出貨單號</label><input id="sh_no" value="${esc(r.shipNo)}"></div>
 <div class="fld"><label>出貨日期 <i>*</i></label><input id="sh_date" type="date" value="${esc(r.date)}" required></div>
 <div class="fld"><label>客戶</label><select id="sh_customer"><option value="">全部客戶</option>${refOpts({ref:'customers'},r.customer).map(([a,b])=>`<option value="${a}"${a===r.customer?' selected':''}>${esc(b)}</option>`).join('')}</select></div>
 <div class="fld"><label>訂單 <i>*</i></label><select id="sh_order"></select></div>
 <div class="fld"><label>車號/物流</label><input id="sh_carrier" value="${esc(r.carrier)}"></div>
 <div class="fld"><label>送貨地址</label><input id="sh_addr" value="${esc(r.addr)}"></div>
 <div class="fld full"><label>備註</label><input id="sh_note" value="${esc(r.note)}"></div>
 <div class="fld full"><label>出貨明細(依缸號/批號選擇庫存)</label><div class="tbl-wrap"><table><thead><tr><th>缸號/批號(庫存)</th><th style="width:110px">捲數</th><th style="width:140px">重量(kg)</th><th style="width:50px"></th></tr></thead><tbody id="sh_lines"></tbody></table></div>
 <div style="margin-top:8px;display:flex;gap:10px;align-items:center"><button type="button" class="btn sm" data-act="sh-add">＋ 新增一行</button><span class="hint" id="sh_info"></span></div></div>
 <div class="mfoot"><button type="button" class="btn" data-act="close">取消</button><button class="btn pri">儲存出貨單</button></div></form>`,1);
 shipOrders();shipRender();
 const b=$('#mb');
 b.oninput=b.onchange=e=>{const t=e.target;
  if(t.id==='sh_customer'){r.customer=t.value;if(t.value&&DB.customers[t.value])$('#sh_addr').value=DB.customers[t.value].addr||'';shipOrders();r.order='';r.lines=[{color:'',lot:'',rolls:'',qty:''}];shipRender()}
  else if(t.id==='sh_order'){r.order=t.value;const o=DB.orders[t.value];if(o){r.customer=o.customer;$('#sh_customer').value=o.customer;$('#sh_addr').value=DB.customers[o.customer]?.addr||''}r.lines=[{color:'',lot:'',rolls:'',qty:''}];shipRender()}
  else if(t.dataset.i!==undefined){const l=r.lines[+t.dataset.i];
   if(t.dataset.k==='key'){const [c,lo]=t.value.split('§');l.color=t.value?c:'';l.lot=t.value?lo:'';
    if(t.value&&e.type==='change'){const x=shipAvail().find(a=>a.fabric===DB.orders[r.order].fabric&&a.color===c&&a.lot===lo);if(x){const used=r.lines.filter((q,j)=>j!==+t.dataset.i&&q.color===c&&q.lot===lo);l.qty=Math.max(0,+(x.bal-sum(used,'qty')).toFixed(2));l.rolls=Math.max(0,x.balR-sum(used,'rolls'))}}
    if(e.type==='change')shipRender()}
   else l[t.dataset.k]=t.value===''?'':num(t.value);shipInfo()}};
 $('#shf').onsubmit=e=>{e.preventDefault();shipSave()}}
function shipAvail(){return fabricRows(SH.id,null)}
function shipOrders(){const r=SH.rec;const act=o=>!['已出貨','已取消'].includes(o.status)||o.id===r.order;
 const os=all('orders').filter(o=>act(o)&&(!r.customer||o.customer===r.customer)).sort((a,b)=>(a.dueDate||'').localeCompare(b.dueDate||''));
 $('#sh_order').innerHTML=`<option value="">請選擇訂單</option>`+os.map(o=>`<option value="${o.id}"${o.id===r.order?' selected':''}>${esc(label('orders',o))}</option>`).join('')}
function shipRender(){const r=SH.rec,o=DB.orders[r.order];
 const opts=o?shipAvail().filter(a=>a.fabric===o.fabric&&(!o.color||a.color===o.color)&&(a.bal>1e-4||r.lines.some(l=>l.color===a.color&&l.lot===a.lot))):[];
 $('#sh_lines').innerHTML=!o?`<tr><td colspan="4" class="empty">請先選擇訂單</td></tr>`:r.lines.map((l,i)=>`<tr><td><select data-i="${i}" data-k="key"><option value="">選擇缸號/批號</option>${opts.map(a=>{const k=a.color+'§'+a.lot;return `<option value="${esc(k)}"${k===l.color+'§'+l.lot&&l.lot!==''?' selected':''}>${esc((a.color?a.color+' / ':'')+a.lot+'｜庫存 '+fmt(a.bal)+'kg / '+fmt(a.balR,0)+'捲')}</option>`}).join('')}</select></td>
  <td><input type="number" data-i="${i}" data-k="rolls" value="${esc(l.rolls)}"></td><td><input type="number" step="any" data-i="${i}" data-k="qty" value="${esc(l.qty)}"></td><td><button type="button" class="btn sm danger" data-act="sh-del" data-i="${i}">✕</button></td></tr>`).join('');
 shipInfo()}
function shipInfo(){const r=SH.rec,o=DB.orders[r.order];if(!o){$('#sh_info').textContent='';return}
 const st=ordStat(o),prev=SH.id?sum(DB.shipments[SH.id]?.lines||[],'qty'):0,now=sum(r.lines,'qty');
 $('#sh_info').textContent=`訂購 ${fmt(o.qty)}kg｜已出貨(不含本單) ${fmt(st.shipped-prev)}kg｜本單 ${fmt(now)}kg / ${fmt(sum(r.lines,'rolls'),0)}捲｜尚欠 ${fmt(num(o.qty)-st.shipped+prev-now)}kg`}
function shipSave(){const r=SH.rec,o=DB.orders[r.order];if(!o)return toast('請選擇訂單',1);
 const lines=r.lines.filter(l=>l.lot!==''||num(l.qty)>0);if(!lines.length)return toast('請至少輸入一行出貨明細',1);
 for(const l of lines){if(!(num(l.qty)>0)||l.lot==='')return toast('每一行都需選擇缸號並輸入大於 0 的重量',1)}
 const av=shipAvail(),g={};lines.forEach(l=>{const k=l.color+'§'+l.lot;g[k]=g[k]||{c:l.color,l:l.lot,q:0};g[k].q+=num(l.qty)});
 for(const k in g){const a=av.find(x=>x.fabric===o.fabric&&x.color===g[k].c&&x.lot===g[k].l);if(g[k].q>(a?a.bal:0)+1e-6)return toast(`缸號 ${g[k].l} 庫存不足(可出 ${fmt(a?a.bal:0)}kg)`,1)}
 const st=ordStat(o),prev=SH.id?sum(DB.shipments[SH.id]?.lines||[],'qty'):0,total=sum(lines,'qty');
 if(st.shipped-prev+total>num(o.qty)*1.0001&&!confirm(`累計出貨 ${fmt(st.shipped-prev+total)}kg 超過訂購量 ${fmt(o.qty)}kg,仍要儲存嗎?`))return;
 const rec=put('shipments',{...(SH.id?DB.shipments[SH.id]:{createdAt:Date.now()}),shipNo:$('#sh_no').value.trim()||r.shipNo,date:$('#sh_date').value,customer:o.customer,order:o.id,carrier:$('#sh_carrier').value.trim(),addr:$('#sh_addr').value.trim(),note:$('#sh_note').value.trim(),
  lines:lines.map(l=>({fabric:o.fabric,color:l.color,lot:l.lot,rolls:num(l.rolls),qty:num(l.qty)})),total});
 syncOrder(o.id);log(SH.id?'修改':'新增','出貨單:'+rec.shipNo);closeModal();route();toast('出貨單已儲存')}
function printShip(id){const s=DB.shipments[id];if(!s)return;const c=DB.customers[s.customer]||{},o=DB.orders[s.order]||{};
 $('#printArea').innerHTML=`<div style="font-family:inherit;color:#000"><h2 style="text-align:center;margin:0">${esc(CFG.company)}</h2><h3 style="text-align:center;margin:4px 0 14px">出 貨 單</h3>
 <table style="width:100%;font-size:13px;margin-bottom:10px"><tr><td style="border:0">出貨單號:${esc(s.shipNo)}</td><td style="border:0">出貨日期:${esc(s.date)}</td></tr>
 <tr><td style="border:0">客戶:${esc(c.name||'')}</td><td style="border:0">訂單編號:${esc(o.orderNo||'')}　客戶單號:${esc(o.po||'')}</td></tr>
 <tr><td style="border:0">電話:${esc(c.phone||'')}</td><td style="border:0">車號/物流:${esc(s.carrier||'')}</td></tr>
 <tr><td style="border:0" colspan="2">送貨地址:${esc(s.addr||c.addr||'')}</td></tr></table>
 <table style="width:100%;border-collapse:collapse;font-size:13px"><thead><tr>${['項次','布種','顏色','缸號/批號','捲數','重量(kg)'].map(h=>`<th style="border:1px solid #000;padding:5px;background:#eee">${h}</th>`).join('')}</tr></thead><tbody>
 ${(s.lines||[]).map((l,i)=>`<tr><td style="border:1px solid #000;padding:5px">${i+1}</td><td style="border:1px solid #000;padding:5px">${esc(nm('fabrics',l.fabric))}</td><td style="border:1px solid #000;padding:5px">${esc(l.color)}</td><td style="border:1px solid #000;padding:5px">${esc(l.lot)}</td><td style="border:1px solid #000;padding:5px;text-align:right">${fmt(l.rolls,0)}</td><td style="border:1px solid #000;padding:5px;text-align:right">${fmt(l.qty)}</td></tr>`).join('')}
 <tr><td colspan="4" style="border:1px solid #000;padding:5px;text-align:right"><b>合計</b></td><td style="border:1px solid #000;padding:5px;text-align:right"><b>${fmt(sum(s.lines||[],'rolls'),0)}</b></td><td style="border:1px solid #000;padding:5px;text-align:right"><b>${fmt(s.total)}</b></td></tr></tbody></table>
 <p style="font-size:13px">備註:${esc(s.note||'')}</p><table style="width:100%;margin-top:40px;font-size:13px"><tr><td style="border:0">出貨人員:__________</td><td style="border:0">司機:__________</td><td style="border:0">客戶簽收:__________</td></tr></table></div>`;
 window.print()}

/* ================= 訂單詳情 ================= */
function showOrder(id){const o=DB.orders[id];if(!o)return;const s=ordStat(o),q=num(o.qty)||1;
 const bar=(l,v)=>`<div style="margin:8px 0"><div style="display:flex;justify-content:space-between;font-size:12px"><span>${l}</span><span>${fmt(v,1)} / ${fmt(o.qty,1)} kg(${fmt(v/q*100,0)}%)</span></div><div class="prog"><i style="width:${Math.min(100,v/q*100)}%"></i></div></div>`;
 const mini=(h,rows)=>`<div class="tbl-wrap" style="margin-top:6px"><table><thead><tr>${h.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>${rows.length?rows.map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join(''):`<tr><td colspan="${h.length}" class="empty">無</td></tr>`}</tbody></table></div>`;
 const f=DB.fabrics[o.fabric],y=DB.yarns[f?.yarn];
 openModal('訂單詳情 — '+o.orderNo,`<div class="two"><div><b>${esc(nm('customers',o.customer))}</b><br>布種:${esc(nm('fabrics',o.fabric))}　顏色:${esc(o.color||'-')}<br>客戶單號:${esc(o.po||'-')}<br>接單:${esc(o.date)}　交期:<b>${esc(o.dueDate)}</b><br>狀態:<span class="badge ${BADGE[o.status]||''}">${o.status}</span></div>
 <div>${bar('排工',s.planned)}${bar('完成量',s.done)}${bar('已出貨',s.shipped)}</div></div>
 <p style="background:#f0fdfa;padding:8px;border-radius:6px">預估需紗 <b>${fmt(s.need,1)}</b> kg(${esc(y?y.name:'未設定用紗')})｜已領紗(淨) <b>${fmt(s.issued,1)}</b> kg｜該紗現有庫存 <b>${fmt(y?yarnTotal(y.id):0,1)}</b> kg</p>
 <b>排工</b>${mini(['機台','開始','結束','計畫','完成','狀態'],s.sch.map(x=>[nm('machines',x.machine),x.start,x.end,fmt(x.planQty),fmt(x.doneQty),x.status]))}
 <br><b>領/退紗</b>${mini(['日期','類別','紗線','批號','kg'],s.outs.map(x=>[x.date,x.type,nm('yarns',x.yarn),x.lot,fmt(x.qty)]))}
 <br><b>出貨</b>${mini(['單號','日期','kg','捲數'],s.ships.map(x=>[x.shipNo,x.date,fmt(x.total),fmt(sum(x.lines||[],'rolls'),0)]))}`,1)}

/* ================= 頁面 ================= */
const state={q:{},gantt:{start:addDays(today(),-3),days:21},showZero:false,fshowZero:false};
const VIEWS={};
Object.keys(S).forEach(c=>{if(c!=='schedules')VIEWS[c]=()=>crudPage(c)});

VIEWS.dashboard=()=>{
 const td=today(),act=all('orders').filter(o=>!['已出貨','已取消'].includes(o.status));
 const yr=yarnRows(),yt=yr.reduce((s,r)=>s+r.bal,0),fr=fabricRows(),ft=fr.reduce((s,r)=>s+r.bal,0);
 const mon=td.slice(0,7),shipM=all('shipments').filter(s=>(s.date||'').startsWith(mon)).reduce((s,x)=>s+num(x.total),0);
 const soon=act.filter(o=>o.dueDate<=addDays(td,7)).sort((a,b)=>a.dueDate.localeCompare(b.dueDate));
 const low=all('yarns').filter(y=>num(y.safety)>0&&yarnTotal(y.id)<num(y.safety));
 const todaySch=all('schedules').filter(s=>s.start<=td&&s.end>=td&&['待生產','生產中'].includes(s.status));
 const empty=!all('orders').length&&!all('customers').length;
 return `<div class="head"><h2>儀表板</h2><div class="tools">${empty?'<button class="btn pri" data-act="demo">載入範例資料</button>':''}</div></div>
 <div class="cards"><div class="kpi"><span>進行中訂單</span><b>${act.length}</b></div><div class="kpi"><span>待排工訂單</span><b>${act.filter(o=>o.status==='待排工').length}</b></div>
 <div class="kpi"><span>7日內到期/逾期</span><b style="color:${soon.length?'var(--red)':'inherit'}">${soon.length}</b></div><div class="kpi"><span>紗庫存(kg)</span><b>${fmt(yt,0)}</b></div>
 <div class="kpi"><span>布庫存(kg)</span><b>${fmt(ft,0)}</b></div><div class="kpi"><span>本月出貨(kg)</span><b>${fmt(shipM,0)}</b></div></div>
 <div class="two"><div><h3>⏰ 交期將至 / 逾期訂單</h3><div class="tbl-wrap"><table><thead><tr><th>訂單</th><th>客戶</th><th>交期</th><th class="num">未交kg</th><th>狀態</th></tr></thead><tbody>
 ${soon.length?soon.map(o=>`<tr><td>${esc(o.orderNo)}</td><td>${esc(nm('customers',o.customer))}</td><td style="color:${o.dueDate<td?'var(--red)':'inherit'}">${o.dueDate}${o.dueDate<td?' (逾期)':''}</td><td class="num">${fmt(num(o.qty)-ordStat(o).shipped,1)}</td><td><span class="badge ${BADGE[o.status]||''}">${o.status}</span></td></tr>`).join(''):'<tr><td colspan="5" class="empty">目前沒有</td></tr>'}</tbody></table></div></div>
 <div><h3>⚠ 低於安全庫存的紗線</h3><div class="tbl-wrap"><table><thead><tr><th>紗線</th><th class="num">庫存kg</th><th class="num">安全庫存</th></tr></thead><tbody>
 ${low.length?low.map(y=>`<tr><td>${esc(label('yarns',y))}</td><td class="num" style="color:var(--red)">${fmt(yarnTotal(y.id))}</td><td class="num">${fmt(y.safety)}</td></tr>`).join(''):'<tr><td colspan="3" class="empty">庫存正常</td></tr>'}</tbody></table></div></div></div>
 <h3 style="margin-top:18px">🏭 今日生產中</h3><div class="tbl-wrap"><table><thead><tr><th>機台</th><th>訂單</th><th>期間</th><th class="num">計畫kg</th><th class="num">已完成kg</th></tr></thead><tbody>
 ${todaySch.length?todaySch.map(s=>`<tr><td>${esc(nm('machines',s.machine))}</td><td>${esc(nm('orders',s.order))}</td><td>${s.start} ~ ${s.end}</td><td class="num">${fmt(s.planQty)}</td><td class="num">${fmt(s.doneQty)}</td></tr>`).join(''):'<tr><td colspan="5" class="empty">今日無排工</td></tr>'}</tbody></table></div>`};

function ganttHTML(){const {start,days}=state.gantt,td=today(),W=['日','一','二','三','四','五','六'];
 const ms=all('machines').sort(byCode);if(!ms.length)return '<div class="empty">請先到「機台資料」建立機台</div>';
 const ds=[...Array(days)].map((_,i)=>addDays(start,i)),tdIdx=ds.indexOf(td),cols=`repeat(${days},minmax(34px,1fr))`;
 let h=`<div class="gantt-sc"><div style="min-width:${130+days*34}px"><div class="g-row"><div class="g-label"><b>機台</b></div><div class="g-head" style="grid-template-columns:${cols}">${ds.map(d=>{const w=new Date(d+'T00:00:00').getDay();return `<div class="${d===td?'td':w===0||w===6?'we':''}">${d.slice(5)}<br>${W[w]}</div>`}).join('')}</div></div>`;
 ms.forEach(m=>{const items=all('schedules').filter(s=>s.machine===m.id&&s.end>=start&&s.start<=ds[days-1]).sort((a,b)=>a.start.localeCompare(b.start));
  const laneEnd=[];const bars=items.map(s=>{let l=laneEnd.findIndex(e=>e<s.start);if(l<0){l=laneEnd.length;laneEnd.push('')}laneEnd[l]=s.end;return{s,l}});
  const lanes=Math.max(1,laneEnd.length);
  h+=`<div class="g-row"><div class="g-label"><b>${esc(m.code)}</b><small>${esc(m.type)}${m.status!=='可用'?'・'+m.status:''}</small></div><div class="g-grid" style="grid-template-columns:${cols};grid-template-rows:repeat(${lanes},24px);background-image:repeating-linear-gradient(to right,transparent 0,transparent calc(100%/${days} - 1px),#e5e7eb calc(100%/${days} - 1px),#e5e7eb calc(100%/${days}))">
  ${tdIdx>=0?`<div class="g-today" style="grid-column:${tdIdx+1};grid-row:1/-1"></div>`:''}
  ${bars.map(({s,l})=>{const a=Math.max(0,diffDays(start,s.start)),b=Math.min(days-1,diffDays(start,s.end));const st={'待生產':0,'生產中':1,'已完成':2,'暫停':3}[s.status]??0;const o=DB.orders[s.order];
   return `<div class="bar s${st}" style="grid-column:${a+1}/${b+2};grid-row:${l+1}" data-act="edit" data-col="schedules" data-id="${s.id}" title="${esc(nm('orders',s.order)+'｜'+s.start+'~'+s.end+'｜計畫'+fmt(s.planQty)+'kg 完成'+fmt(s.doneQty)+'kg｜'+s.status)}">${esc((o?o.orderNo:'')+' '+(DB.customers[o?.customer]?.name||''))} ${fmt(s.doneQty,0)}/${fmt(s.planQty,0)}</div>`}).join('')}</div></div>`});
 return h+`</div></div><div class="legend" style="margin-top:8px"><span><b style="background:#6b7280"></b>待生產</span><span><b style="background:#2563eb"></b>生產中</span><span><b style="background:#16a34a"></b>已完成</span><span><b style="background:#dc2626"></b>暫停</span><span style="color:var(--mu)">點選色塊可編輯排工</span></div>`}
VIEWS.schedule=()=>`<div class="head"><h2>排工排程</h2><div class="tools"><button class="btn" data-act="g-prev">◀ 前一週</button><input type="date" style="width:150px" data-act="g-start" value="${state.gantt.start}"><button class="btn" data-act="g-next">後一週 ▶</button><button class="btn" data-act="g-today">今天</button>
 <select style="width:90px" data-act="g-days">${[14,21,30,45].map(n=>`<option value="${n}"${n===state.gantt.days?' selected':''}>${n}天</option>`).join('')}</select><button class="btn pri" data-act="add" data-col="schedules">＋ 新增排工</button></div></div>
 <div class="card" id="gantt">${ganttHTML()}</div><div class="head sub"><h3>排工明細</h3>${searchBox('schedules')}<button class="btn" data-act="csv" data-col="schedules">匯出 CSV</button></div>${listWrap('schedules')}`;

VIEWS.yarnStock=()=>{const rows=yarnRows(),by={};all('yarns').forEach(y=>by[y.id]={y,bal:0,inQ:0,outQ:0,lots:0});
 rows.forEach(r=>{const o=by[r.yarn];if(o){o.bal+=r.bal;o.inQ+=r.inQ;o.outQ+=r.outQ;if(r.bal>1e-4)o.lots++}});
 const det=rows.filter(r=>state.showZero||Math.abs(r.bal)>1e-4).sort((a,b)=>nm('yarns',a.yarn).localeCompare(nm('yarns',b.yarn))||a.lot.localeCompare(b.lot));
 return `<div class="head"><h2>紗庫存</h2><div class="tools"><label><input type="checkbox" style="width:auto" data-act="showzero" ${state.showZero?'checked':''}> 顯示庫存為 0 的批號</label><button class="btn" data-act="csv-ystock">匯出明細 CSV</button></div></div>
 <h3>依紗線彙總</h3><div class="tbl-wrap"><table><thead><tr><th>紗線</th><th class="num">累計入庫kg</th><th class="num">累計領用kg</th><th class="num">庫存kg</th><th class="num">批數</th><th class="num">安全庫存</th><th>狀態</th></tr></thead><tbody>
 ${Object.values(by).sort((a,b)=>byCode(a.y,b.y)).map(o=>{const low=num(o.y.safety)>0&&o.bal<num(o.y.safety);return `<tr><td>${esc(label('yarns',o.y))}</td><td class="num">${fmt(o.inQ)}</td><td class="num">${fmt(o.outQ)}</td><td class="num"><b>${fmt(o.bal)}</b></td><td class="num">${o.lots}</td><td class="num">${fmt(o.y.safety)}</td><td>${low?'<span class="badge red">低於安全庫存</span>':'<span class="badge green">正常</span>'}</td></tr>`}).join('')||'<tr><td colspan="7" class="empty">尚無紗線資料</td></tr>'}</tbody></table></div>
 <h3 style="margin-top:18px">批號明細</h3><div class="tbl-wrap"><table><thead><tr><th>紗線</th><th>批號</th><th>倉位</th><th>最近入庫</th><th class="num">入庫kg</th><th class="num">領用kg</th><th class="num">庫存kg</th></tr></thead><tbody>
 ${det.map(r=>`<tr><td>${esc(nm('yarns',r.yarn))}</td><td>${esc(r.lot)}</td><td>${esc(r.loc)}</td><td>${esc(r.last||'')}</td><td class="num">${fmt(r.inQ)}</td><td class="num">${fmt(r.outQ)}</td><td class="num"><b>${fmt(r.bal)}</b></td></tr>`).join('')||'<tr><td colspan="7" class="empty">無庫存</td></tr>'}</tbody></table></div>`};
VIEWS.fabricStock=()=>{const rows=fabricRows(),by={};
 rows.forEach(r=>{const o=by[r.fabric]||(by[r.fabric]={bal:0,balR:0,n:0});o.bal+=r.bal;o.balR+=r.balR;if(r.bal>1e-4)o.n++});
 const det=rows.filter(r=>state.fshowZero||Math.abs(r.bal)>1e-4).sort((a,b)=>nm('fabrics',a.fabric).localeCompare(nm('fabrics',b.fabric))||a.color.localeCompare(b.color)||a.lot.localeCompare(b.lot));
 return `<div class="head"><h2>布庫存</h2><div class="tools"><label><input type="checkbox" style="width:auto" data-act="fshowzero" ${state.fshowZero?'checked':''}> 顯示庫存為 0 的缸號</label><button class="btn" data-act="csv-fstock">匯出明細 CSV</button><button class="btn pri" data-act="add" data-col="fabricIn">＋ 布入庫/調整</button></div></div>
 <h3>依布種彙總</h3><div class="tbl-wrap"><table><thead><tr><th>布種</th><th class="num">庫存kg</th><th class="num">庫存捲數</th><th class="num">缸數</th></tr></thead><tbody>
 ${Object.keys(by).map(k=>`<tr><td>${esc(nm('fabrics',k))}</td><td class="num"><b>${fmt(by[k].bal)}</b></td><td class="num">${fmt(by[k].balR,0)}</td><td class="num">${by[k].n}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">尚無布庫存</td></tr>'}</tbody></table></div>
 <h3 style="margin-top:18px">缸號明細</h3><div class="tbl-wrap"><table><thead><tr><th>布種</th><th>顏色</th><th>缸號/批號</th><th>倉位</th><th class="num">入庫kg</th><th class="num">已出貨kg</th><th class="num">庫存kg</th><th class="num">庫存捲數</th></tr></thead><tbody>
 ${det.map(r=>`<tr><td>${esc(nm('fabrics',r.fabric))}</td><td>${esc(r.color)}</td><td>${esc(r.lot)}</td><td>${esc(r.loc)}</td><td class="num">${fmt(r.inQ)}</td><td class="num">${fmt(r.outQ)}</td><td class="num"><b>${fmt(r.bal)}</b></td><td class="num">${fmt(r.balR,0)}</td></tr>`).join('')||'<tr><td colspan="8" class="empty">無庫存</td></tr>'}</tbody></table></div>`};

VIEWS.settings=()=>{const logs=all('logs').sort((a,b)=>b.ts-a.ts).slice(0,80);
 return `<div class="head"><h2>系統設定</h2></div>
 <div class="card"><h3 style="margin-top:0">☁ 多人共用(雲端同步)</h3>
 <p style="color:var(--mu);margin-top:0">請貼上 Firebase Realtime Database 網址,所有使用者設定相同網址即可共用同一份資料(或由管理員直接寫在檔案最上方 PRESET.cloudUrl,使用者就不用再設定)。</p>
 <div class="grid"><div class="fld full"><label>Database URL</label><input id="s_url" placeholder="https://xxxx-default-rtdb.asia-southeast1.firebasedatabase.app" value="${esc(CFG.url)}"></div>
 <div class="fld"><label>驗證密鑰(選填,Database secret / token)</label><input id="s_auth" value="${esc(CFG.auth)}"></div><div class="fld"><label>公司名稱(出貨單抬頭)</label><input id="s_co" value="${esc(CFG.company)}"></div></div>
 <div class="tools" style="margin-top:10px"><button class="btn pri" data-act="cloud-save">儲存並連線</button><button class="btn" data-act="cloud-pull">從雲端重新載入</button><button class="btn" data-act="cloud-push">將本機資料覆蓋到雲端</button><button class="btn danger" data-act="cloud-off">改回單機模式</button></div></div>
 <div class="card"><h3 style="margin-top:0">💾 備份與還原</h3><div class="tools"><button class="btn" data-act="backup">下載完整備份(JSON)</button><label class="btn">匯入還原<input type="file" accept=".json" data-act="restore" style="display:none"></label><button class="btn" data-act="demo">載入範例資料</button><button class="btn danger" data-act="wipe">清空所有資料</button></div></div>
 <div class="card"><h3 style="margin-top:0">📜 最近操作紀錄</h3><div class="tbl-wrap"><table><thead><tr><th>時間</th><th>使用者</th><th>動作</th><th>內容</th></tr></thead><tbody>${logs.map(l=>`<tr><td>${new Date(l.ts).toLocaleString('zh-TW')}</td><td>${esc(l.user)}</td><td>${esc(l.act)}</td><td>${esc(l.desc)}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">尚無紀錄</td></tr>'}</tbody></table></div></div>`};

const NAV=[['主要作業',[['dashboard','📊','儀表板'],['orders','📝','訂單管理'],['schedule','🗓️','排工排程'],['yarnIn','📥','入紗作業'],['yarnOut','🧵','領紗/退紗'],['fabricIn','📦','布入庫/調整'],['shipments','🚚','出貨作業']]],
 ['庫存查詢',[['yarnStock','🧶','紗庫存'],['fabricStock','🧱','布庫存']]],
 ['基本資料',[['customers','👥','客戶資料'],['suppliers','🏭','供應商'],['yarns','🪢','紗線資料'],['fabrics','🎽','布種資料'],['machines','⚙️','機台資料']]],
 ['系統',[['settings','🔧','系統設定']]]];
function route(){const h=(location.hash||'#/dashboard').slice(2),v=VIEWS[h]?h:'dashboard';
 $('#nav').innerHTML=NAV.map(([t,items])=>`<div class="nsec">${t}</div>`+items.map(([k,i,n])=>`<a href="#/${k}" class="${k===v?'on':''}">${i} ${n}</a>`).join('')).join('');
 $('#main').innerHTML=VIEWS[v]();$('#side').classList.remove('open');pend=false}

/* ================= 範例資料 ================= */
function demo(){if(all('orders').length&&!confirm('已有資料,範例資料會「新增」到現有資料中,確定?'))return;
 const t=today(),I=(c,id,r)=>put(c,{id,...r});
 I('customers','dc1',{code:'C001',name:'遠東服飾',contact:'王經理',phone:'02-2222-1111',addr:'新北市板橋區文化路一段100號',terms:'月結60天'});
 I('customers','dc2',{code:'C002',name:'永盛運動',contact:'林小姐',phone:'04-2333-4444',addr:'台中市西屯區工業區一路8號',terms:'月結30天'});
 I('suppliers','ds1',{code:'S001',name:'大成紡紗',contact:'陳先生',phone:'03-111-2222'});I('suppliers','ds2',{code:'S002',name:'宏遠化纖',contact:'李小姐',phone:'06-333-4444'});
 I('yarns','dy1',{code:'Y-C40',name:'40/1 精梳棉紗',material:'棉',safety:500,price:150});I('yarns','dy2',{code:'Y-P150',name:'聚酯 DTY 150D/48F',material:'聚酯',safety:800,price:85});I('yarns','dy3',{code:'Y-SP40',name:'氨綸 40D',material:'氨綸',safety:100,price:320});
 I('fabrics','df1',{code:'F-JER01',name:'純棉單面汗布',composition:'100% Cotton',width:175,gsm:160,yarn:'dy1',ratio:1.05,price:230});
 I('fabrics','df2',{code:'F-PQ02',name:'聚酯吸排珠地布',composition:'100% Polyester',width:160,gsm:140,yarn:'dy2',ratio:1.04,price:160});
 [['dm1','KN-01','28吋圓編機','圓編機',450],['dm2','KN-02','30吋圓編機','圓編機',500],['dm3','DY-01','染色機 800kg','染色機',800],['dm4','FIN-01','定型機','定型機',1500]].forEach(([id,c,n,ty,cp])=>I('machines',id,{code:c,name:n,type:ty,cap:cp,status:'可用'}));
 I('yarnIn','di1',{date:addDays(t,-12),poNo:'PO-0001',supplier:'ds1',yarn:'dy1',lot:'C2410-A',qty:2000,bags:80,price:150,loc:'A-01',qc:'合格'});
 I('yarnIn','di2',{date:addDays(t,-8),poNo:'PO-0002',supplier:'ds2',yarn:'dy2',lot:'P2410-B',qty:3000,bags:120,price:85,loc:'A-02',qc:'合格'});
 I('yarnIn','di3',{date:addDays(t,-3),poNo:'PO-0003',supplier:'ds1',yarn:'dy3',lot:'S2410-C',qty:60,bags:6,price:320,loc:'A-03',qc:'合格'});
 I('orders','do1',{orderNo:'SO-DEMO-01',date:addDays(t,-7),customer:'dc1',po:'FE-8801',fabric:'df1',color:'黑色',qty:1200,price:230,dueDate:addDays(t,6),status:'生產中'});
 I('orders','do2',{orderNo:'SO-DEMO-02',date:addDays(t,-1),customer:'dc2',po:'YS-2210',fabric:'df2',color:'白色',qty:800,price:160,dueDate:addDays(t,18),status:'待排工'});
 I('schedules','ds_1',{order:'do1',machine:'dm1',start:addDays(t,-2),end:addDays(t,1),planQty:1200,doneQty:600,status:'生產中'});
 I('yarnOut','dyo1',{date:addDays(t,-2),type:'領用',order:'do1',yarn:'dy1',lot:'C2410-A',qty:700,machine:'dm1',by:USER});
 I('fabricIn','dfi1',{date:addDays(t,-1),type:'下機入庫',order:'do1',fabric:'df1',color:'黑色',lot:'D1105A',qty:300,rolls:12,loc:'B-01'});
 syncOrder('do1');log('範例','載入範例資料');route();toast('已載入範例資料')}

/* ================= 事件 ================= */
document.addEventListener('click',async e=>{const t=e.target.closest('[data-act]');if(!t)return;const a=t.dataset.act,col=t.dataset.col,id=t.dataset.id;
 switch(a){
 case 'menu':$('#side').classList.toggle('open');break;
 case 'close':closeModal();break;
 case 'add':openForm(col);break;case 'edit':openForm(col,id);break;case 'del':delRec(col,id);break;
 case 'csv':csvOut(col);break;case 'detail':showOrder(id);break;case 'print':printShip(id);break;
 case 'sh-add':SH.rec.lines.push({color:'',lot:'',rolls:'',qty:''});shipRender();break;
 case 'sh-del':SH.rec.lines.splice(+t.dataset.i,1);if(!SH.rec.lines.length)SH.rec.lines.push({color:'',lot:'',rolls:'',qty:''});shipRender();break;
 case 'g-prev':state.gantt.start=addDays(state.gantt.start,-7);$('#gantt').innerHTML=ganttHTML();break;
 case 'g-next':state.gantt.start=addDays(state.gantt.start,7);$('#gantt').innerHTML=ganttHTML();break;
 case 'g-today':state.gantt.start=addDays(today(),-3);route();break;
 case 'rename':{const n=prompt('請輸入您的姓名(用於操作紀錄)',USER);if(n){USER=n.trim();localStorage.setItem('tex_user',USER);$('#uname').textContent=USER}break}
 case 'demo':demo();break;
 case 'csv-ystock':dl('紗庫存_'+today()+'.csv',[['紗線','批號','倉位','入庫kg','領用kg','庫存kg']].concat(yarnRows().map(r=>[nm('yarns',r.yarn),r.lot,r.loc,r.inQ,r.outQ,r.bal])));break;
 case 'csv-fstock':dl('布庫存_'+today()+'.csv',[['布種','顏色','缸號','倉位','入庫kg','出貨kg','庫存kg','庫存捲數']].concat(fabricRows().map(r=>[nm('fabrics',r.fabric),r.color,r.lot,r.loc,r.inQ,r.outQ,r.bal,r.balR])));break;
 case 'backup':{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({version:1,exported:new Date().toISOString(),data:DB})],{type:'application/json'}));a.download=`紡織ERP備份_${today()}.json`;a.click();break}
 case 'wipe':{if(prompt('此動作會清空所有資料(含雲端)!請輸入「清空」確認')!=='清空')break;DB=emptyDB();cache();try{if(cloudOn())await cReq('','DELETE')}catch(x){}route();toast('已清空');break}
 case 'cloud-save':{CFG.url=$('#s_url').value.trim().replace(/\/+$/,'');CFG.auth=$('#s_auth').value.trim();CFG.company=$('#s_co').value.trim()||PRESET.company;
  localStorage.setItem('tex_cfg',JSON.stringify(CFG));setSync('');
  if(!CFG.url){toast('已儲存(單機模式)');route();break}
  try{const d=await cReq('','GET');if(d&&Object.keys(d).length){if(confirm('雲端已有資料,將載入雲端資料(本機資料不會上傳)。確定?')){DB=norm(d);cache()}}
   else{await pushAll();toast('已連線,並將本機資料上傳到雲端')}route();toast('雲端連線成功')}catch(x){toast('連線失敗:'+x.message+'(請檢查網址與資料庫規則)',1)}break}
 case 'cloud-pull':if(!cloudOn())return toast('尚未設定雲端',1);await pull(true);toast('已重新載入');break;
 case 'cloud-push':if(!cloudOn())return toast('尚未設定雲端',1);if(confirm('將以本機資料覆蓋雲端上的所有資料,確定?')){try{await pushAll();toast('已上傳')}catch(x){toast('失敗:'+x.message,1)}}break;
 case 'cloud-off':CFG.url='';localStorage.setItem('tex_cfg',JSON.stringify({...CFG,url:''}));setSync('');route();toast('已改回單機模式');break;
 }});
document.addEventListener('input',e=>{const t=e.target;if(t.dataset.act==='q'){state.q[t.dataset.col]=t.value;$('#list_'+t.dataset.col).innerHTML=tableHTML(t.dataset.col)}});
document.addEventListener('change',e=>{const t=e.target,a=t.dataset.act;
 if(a==='g-start'&&t.value){state.gantt.start=t.value;$('#gantt').innerHTML=ganttHTML()}
 else if(a==='g-days'){state.gantt.days=+t.value;$('#gantt').innerHTML=ganttHTML()}
 else if(a==='showzero'){state.showZero=t.checked;route()}else if(a==='fshowzero'){state.fshowZero=t.checked;route()}
 else if(a==='restore'&&t.files[0]){const fr=new FileReader();fr.onload=async()=>{try{const j=JSON.parse(fr.result);if(!j.data)throw 0;if(!confirm('匯入會以備份檔取代目前所有資料,確定?'))return;DB=norm(j.data);cache();if(cloudOn())await pushAll();route();toast('還原完成')}catch(x){toast('檔案格式錯誤',1)}};fr.readAsText(t.files[0])}});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
window.addEventListener('hashchange',route);

/* ================= 啟動 ================= */
(async function init(){
 $('#brandName').textContent=(CFG.company||'紡織廠').replace(/股份有限公司|有限公司/,'')+' 生產管理';
 try{const c=localStorage.getItem('tex_db');if(c)DB=norm(JSON.parse(c))}catch(e){}
 if(!USER){USER=(prompt('歡迎使用!請輸入您的姓名(用於操作紀錄)','')||'未命名').trim();localStorage.setItem('tex_user',USER)}
 $('#uname').textContent=USER;setSync('');
 if(cloudOn()){try{const d=await cReq('','GET');DB=norm(d||{});cache()}catch(e){toast('雲端連線失敗,先使用本機快取資料',1)}setInterval(()=>pull(false),8000)}
 route()})();
</script>
</body>
</html>
